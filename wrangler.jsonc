{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bosku-one-system",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./dist",
  // Dedicated Bosku production D1; local development remains isolated via --local.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bosku-one-system-db",
    "database_id": "d1553757-d9b0-42e9-b89d-27fba2518d2a",
    "migrations_dir": "migrations"
  }]
}
